# ── Provider switches ─────────────────────────────────────────────────────────
# Each defaults to mock/local — no external calls needed in development.
# Change to the real provider name when you have credentials.
PAYMENT_PROVIDER=mock          # mock | chapa | telebirr
SMS_PROVIDER=mock              # mock | twilio | africas_talking
PUSH_PROVIDER=mock             # mock | fcm
STORAGE_PROVIDER=local         # local | cloudinary

# ── Chapa Payment (https://chapa.co) ─────────────────────────────────────────
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret
CHAPA_CALLBACK_URL=https://yourdomain.com/api/payments/webhook
CHAPA_RETURN_URL=repairbooking://payment-complete

# ── Telebirr Payment (Ethio Telecom Super App) ───────────────────────────────
TELEBIRR_APP_ID=your_telebirr_app_id
TELEBIRR_APP_KEY=your_telebirr_app_key
TELEBIRR_SHORT_CODE=your_short_code
TELEBIRR_PUBLIC_KEY=your_rsa_public_key_base64
TELEBIRR_NOTIFY_URL=https://yourdomain.com/api/payments/webhook
TELEBIRR_RETURN_URL=repairbooking://payment-complete

# ── Twilio SMS (https://twilio.com) ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ── Africa's Talking SMS (https://africastalking.com) ────────────────────────
AT_API_KEY=your_at_api_key
AT_USERNAME=your_at_username
AT_SENDER_ID=RepairApp

